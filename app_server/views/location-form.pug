extends layout

block content
  .row.banner
    .col-12
      h1
        i.fas.fa-map-marker-alt.mr-2
        | #{title}
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      .card.shadow-sm
        .card-body.p-4
          form(action=`${location._id ? '/location/' + location._id + '/edit' : '/location/new'}` method="POST")
            .form-group
              label.font-weight-bold(for="name") Name
              input.form-control(type="text" id="name" name="name" value=location.name placeholder="Location name" required)
            .form-group
              label.font-weight-bold(for="address") Address
              input.form-control(type="text" id="address" name="address" value=location.address placeholder="Street address")
            .form-group
              label.font-weight-bold(for="facilities") Facilities
              input.form-control(type="text" id="facilities" name="facilities" value=location.facilities ? location.facilities.join(', ') : '' placeholder="wifi, coffee, food")
              small.form-text.text-muted Comma separated
            .form-row
              .form-group.col-md-6
                label.font-weight-bold(for="lat") Latitude
                input.form-control(type="number" step="any" id="lat" name="lat" value=location.coords ? location.coords.coordinates[1] : '' placeholder="e.g. 51.45")
              .form-group.col-md-6
                label.font-weight-bold(for="lng") Longitude
                input.form-control(type="number" step="any" id="lng" name="lng" value=location.coords ? location.coords.coordinates[0] : '' placeholder="e.g. -0.97")
            button.btn.btn-primary(type="submit")
              i.fas.fa-save.mr-1
              | Save Location
            a.btn.btn-secondary.ml-2(href="/") Cancel
