extends layout

block content
  .row.banner
    .col-12
      h1
        i.fas.fa-pen.mr-2
        | Review "#{location.name}"
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      .card.shadow-sm
        .card-body.p-4
          form(action=`/location/${location._id}/review/new` method="POST")
            .form-group
              label.font-weight-bold(for="name") Your name
              input.form-control(type="text" id="name" name="name" placeholder="Enter your name")
            .form-group
              label.font-weight-bold(for="rating") Rating
              select.form-control(id="rating" name="rating")
                option(value="" disabled selected) Select a rating...
                option(value="5") 5 - Excellent
                option(value="4") 4 - Good
                option(value="3") 3 - Average
                option(value="2") 2 - Poor
                option(value="1") 1 - Terrible
                option(value="0") 0 - Awful
            .form-group
              label.font-weight-bold(for="review") Your review
              textarea.form-control(id="review" rows="5" placeholder="Share your experience..." name="review")
            button.btn.btn-primary(type="submit")
              i.fas.fa-paper-plane.mr-1
              | Submit Review